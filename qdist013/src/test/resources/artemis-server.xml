<configuration xmlns="urn:activemq" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			   xsi:schemaLocation="urn:activemq /schema/artemis-configuration.xsd">
	<core xmlns="urn:activemq:core">
		<acceptors>
			<acceptor name="invm">vm://0</acceptor>
		</acceptors>
		<security-enabled>false</security-enabled>
		<persistence-enabled>false</persistence-enabled>
		<address-settings>
			<address-setting match="qdist013">
				<dead-letter-address>qdist013Bq</dead-letter-address>
				<expiry-address>qdist013Bq</expiry-address>
				<max-delivery-attempts>1</max-delivery-attempts>
			</address-setting>
		</address-settings>

		<addresses>
			<address name="qdist013FunkFeil">
				<anycast>
					<queue name="qdist013FunkFeil"/>
				</anycast>
			</address>
			<address name="qdist013">
				<anycast>
					<queue name="qdist013"/>
				</anycast>
			</address>
			<address name="qdist013Bq">
				<anycast>
					<queue name="qdist013Bq"/>
				</anycast>
			</address>
		</addresses>
	</core>
</configuration>